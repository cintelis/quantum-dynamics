# Copy to .env (never commit or share it).
# Cloudflare Zero Trust → Networks → Tunnels → quantum → the token after --token
CLOUDFLARE_TUNNEL_TOKEN=

# How much of the VM the simulations may use
QUANTUM_CPUS=4
QUANTUM_MEMORY=6g

# Only used if Cloudflare Access is put back in front (QUANTUM_ACCESS=1): these emails may delete any run
QUANTUM_ADMINS=

# Sign-up: two long random strings, e.g. python -c "import secrets; print(secrets.token_urlsafe(32))"
# SESSION_KEY signs the sign-in cookie (changing it signs everyone out); ADMIN_KEY is typed at /admin
QUANTUM_SESSION_KEY=
QUANTUM_ADMIN_KEY=

# Where push.ps1 deploys to (Windows): user@host and the SSH key
QUANTUM_VM=
QUANTUM_VM_KEY=
